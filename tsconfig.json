{
	"extends": "@wp-blocks/tsconfig",
	"compilerOptions": {
		"rootDir": "assets/js",
		"outDir": "assets/js/build-types",
		"strict": true,
		"noImplicitAny": false,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"pretty": true,
		"typeRoots": ["./node_modules/@types"]
	},
	"include": [
		"assets/js",
		"assets/js/blocks/audio-source/block.json",
		"assets/js/blocks/player/block.json"
	],
	"exclude": ["**/*.test.ts", "build/**/*", "build-types/**/*"]
}
